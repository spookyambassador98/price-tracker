# PostgreSQL connection string (pooled for the app)
DATABASE_URL="postgresql://price_tracker:price_tracker@localhost:5432/price_tracker?schema=public"
# Direct (unpooled) URL for Prisma migrations
DIRECT_DATABASE_URL="postgresql://price_tracker:price_tracker@localhost:5432/price_tracker?schema=public"

# HTTP server
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# Protects GET/POST /api/scrape/run-now (Vercel Cron and GitHub Actions send Bearer)
CRON_SECRET="change-me"

# How often to re-check prices, as a cron expression (local process only; production uses GitHub Actions)
SCRAPE_CRON="0 * * * *"

# SMTP (Nodemailer). For SendGrid: host=smtp.sendgrid.net, user=apikey, pass=<SENDGRID_API_KEY>
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Price Tracker <alerts@example.com>"

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Playwright
SCRAPE_TIMEOUT_MS=30000
SCRAPE_CONCURRENCY=2
# Optional: path to Chrome/Chromium if channel "chrome" is not available
# PLAYWRIGHT_EXECUTABLE_PATH=""
